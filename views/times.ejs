<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Times</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Lista de Times</h1>

    <% if (times.length > 0) { %>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Estádio</th>
                    <th>Cidade</th>
                    <th>Ação</th>
                </tr>
            </thead>

            <tbody>
                <% times.forEach(time => { %>
                    <tr>
                        <td><%= time.id %></td>
                        <td><%= time.nome %></td>
                        <td><%= time.estadio %></td>
                        <td><%= time.cidade %></td>
                        <td>
                            <a href="/times/<%= time.id %>">
                                Ver detalhes
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    <% } else { %>

        <p>Nenhum time cadastrado.</p>

    <% } %>

    <br>

    <a class="btn" href="/">
        Voltar
    </a>

</body>
</html>